using System;

public class HelloWorld
{
    public static void Main(string[] args)
    {
       int numero;
        int soma = 0;
        
        Console.WriteLine("Digite números (0 para que pare)");
            numero = int.Parse(Console.ReadLine());
            
    while (numero != 0)
    {
    if (numero > 0)
    {
    soma += numero;
    }
    numero = int.Parse(Console.ReadLine());
    }
    Console.WriteLine("A soma dos numeros é:" + soma);
      
    }
}
